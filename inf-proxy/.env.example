# --- Upstream model (OpenAI-compatible) ---
INF_PROXY_MODEL_BASE_URL=http://dummy-model:8000/v1
# INF_PROXY_MODEL_API_KEY=sk-...
INF_PROXY_APP_PORT=9000

# Hostname the proxy forwards to — this is the ledger resolution key and MUST
# match the `hostname` the model declares at startup (POST /model-deployments/
# declare). Defaults to the host parsed from INF_PROXY_MODEL_BASE_URL; override
# here if they differ.
# INF_PROXY_MODEL_HOSTNAME=dummy-model

# --- Message writer (the tap destination) ---
INF_PROXY_TAP_ENABLED=true
INF_PROXY_MESSAGE_WRITER_URL=http://message-writer:8100
INF_PROXY_MESSAGE_WRITER_PATH=/inferences
INF_PROXY_MESSAGE_WRITER_TIMEOUT=30

# --- Output reporting (does NOT change generation) ---
INF_PROXY_LOGPROBS=true
INF_PROXY_TOP_LOGPROBS=5

# --- Seed injection (the one sampling param the proxy may set) ---
# If set, the proxy injects this seed into requests that don't already carry one,
# making generation reproducible and recording the seed in the ledger. Leave
# unset/blank to inject nothing (requests pass through untouched).
# INF_PROXY_SEED=42

# --- Logging ---
# Console verbosity (DEBUG, INFO, WARNING, ERROR). ERROR+ is always written to
# the error log file regardless of this level.
LOG_LEVEL=INFO
# Per-component error log file (ERROR+). Defaults to logs/<component>-error.log.
# ERROR_LOG_FILE=logs/inf-proxy-error.log
