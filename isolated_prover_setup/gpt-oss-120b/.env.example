# Copy to .env next to docker-compose.yml and edit. Compose reads it
# automatically. The addresses and paths below are examples — the compose file
# has no defaults for them and refuses to start until they are set.

# Address of the tapped interface on this node. MUST NOT be 0.0.0.0 — a
# listener on another interface is reachable by a path the tap cannot see.
BIND_ADDR=192.0.2.2
PORT=8000

# Which GPU to use (nvidia-smi -L to list). One GPU only: TP must stay 1.
GPU_ID=0

# Model directory on the host. A plain model dir (config.json + safetensors),
# not a HuggingFace hub cache — see the compose comments for why that
# distinction matters.
MODEL_DIR=/opt/models/gpt-oss-120b
