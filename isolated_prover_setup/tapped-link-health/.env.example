# Copy to .env before the first `docker compose up -d`. (.env is gitignored.)
# IMAGE and the two addresses have no defaults in the compose file; it refuses
# to start until they are set. The values below are examples.

# Any image already on this node with a python3 on PATH. Nothing is pulled —
# see pull_policy in docker-compose.yml. Keep equal to the tag the prover's
# compose file pins, so there is only ever one large image on the node.
IMAGE=vllm/vllm-openai:v0.25.1

# The two ends of the tapped link. PEER_ADDR is the responder (the capture
# host); BIND_ADDR is this node's address on that link.
PEER_ADDR=192.0.2.1
BIND_ADDR=192.0.2.2

# Port and cadence are part of what frame-processor is told to expect: changing
# either means changing FRAME_PROCESSOR_EXPECTED_BEATS and the pin digests with
# it. Raising INTERVAL lowers the bytes on the link proportionally; one capture
# window (300s) is the point past which a blind capture is noticed a window
# late rather than within a beat.
PORT=9999
INTERVAL=30
