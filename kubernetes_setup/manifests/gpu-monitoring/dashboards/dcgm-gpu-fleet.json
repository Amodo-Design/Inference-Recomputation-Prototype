      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(DCGM_FI_DEV_GPU_TEMP{node=~\"$node\", gpu=~\"$gpu\"})",
          "refId": "A",
