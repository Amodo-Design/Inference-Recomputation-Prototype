{
  "title": "GPU Fleet / DCGM",
  "uid": "dcgm-gpu-fleet",
  "tags": [
    "gpu",
    "dcgm",
    "infver"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1s",
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL, node)",
          "refId": "node"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        }
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL{node=~\"$node\"}, gpu)",
          "refId": "gpu"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "GPUs",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(DCGM_FI_DEV_GPU_UTIL{node=~\"$node\", gpu=~\"$gpu\"})",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      }
    },
    {
      "type": "stat",
      "title": "Nodes reporting",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(count by (node) (DCGM_FI_DEV_GPU_UTIL{node=~\"$node\", gpu=~\"$gpu\"}))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      }
    },
    {
      "type": "stat",
      "title": "Mean utilisation",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{node=~\"$node\", gpu=~\"$gpu\"})",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      }
    },
