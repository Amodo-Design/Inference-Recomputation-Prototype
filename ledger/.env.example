# Postgres container credentials (used by the `db` service). Set your own password.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>
POSTGRES_DB=ledger

# Connection string used by the FastAPI access layer (the `api` service).
# Host `db` is the compose service name; use `localhost` when running the app
# outside docker against the published port.
DATABASE_URL=postgresql+psycopg://ledger:<CHANGE_ME_POSTGRES_PASSWORD>@db:5432/ledger

# --- Logging ---
# Console verbosity (DEBUG, INFO, WARNING, ERROR). ERROR+ is always written to
# the error log file regardless of this level.
LOG_LEVEL=INFO
# Per-component error log file (ERROR+). Defaults to logs/<component>-error.log.
# ERROR_LOG_FILE=logs/ledger-error.log
