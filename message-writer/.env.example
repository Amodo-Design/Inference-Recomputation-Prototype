# Ledger Access Layer to resolve against and write to.
LEDGER_API_URL=http://ledger-api:8000
MESSAGE_WRITER_LEDGER_TIMEOUT=30

MESSAGE_WRITER_APP_PORT=8100

# Store raw token-id/logprob payloads in the inference_event BYTEA columns
# (alongside their hashes). Set false to store only the hashes.
MESSAGE_WRITER_STORE_RAW_LOGITS=true

# --- Logging ---
# Console verbosity (DEBUG, INFO, WARNING, ERROR). ERROR+ is always written to
# the error log file regardless of this level.
LOG_LEVEL=INFO
# Per-component error log file (ERROR+). Defaults to logs/<component>-error.log.
# ERROR_LOG_FILE=logs/message-writer-error.log
